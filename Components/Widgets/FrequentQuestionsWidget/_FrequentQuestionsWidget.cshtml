@using Components.Widgets.FrequentQuestionsWidget

@model FrequentQuestionsWidgetViewModel

<style>
    .faq-section {
        min-height: 100vh;
        background-color: #1a1b26;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4rem 1rem;
    }

    .faq-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #a78bfa;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .faq-description {
        color: #9ca3af;
        text-align: center;
        max-width: 48rem;
        margin-bottom: 4rem;
        font-size: 1.125rem;
        line-height: 1.6;
    }

    .faq-container {
        width: 100%;
        max-width: 56rem;
    }

    .faq-item {
        background-color: #24263a;
        border: 1px solid #2e3046;
        border-radius: 0.75rem;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .faq-question-button {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        text-align: left;
        background: none;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .faq-question-button:hover {
        background-color: rgba(255, 255, 255, 0.02);
    }

    .faq-question-text {
        color: white;
        font-weight: 600;
        font-size: 1.125rem;
        flex: 1;
    }

    .faq-icon {
        width: 1.25rem;
        height: 1.25rem;
        color: white;
        flex-shrink: 0;
        margin-left: 1rem;
        transition: transform 0.3s ease;
    }

    .faq-icon.open {
        transform: rotate(180deg);
    }

    .faq-answer {
        padding: 0 1.5rem 1.25rem;
        color: #9ca3af;
        line-height: 1.6;
        display: none;
    }

    .faq-answer.open {
        display: block;
        animation: slideDown 0.3s ease;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (min-width: 768px) {
        .faq-title {
            font-size: 3rem;
        }
    }

    .empty-state {
        text-align: center;
        color: #9ca3af;
        padding: 2rem;
    }
</style>

<div class="faq-section">
    <!-- Section Header -->
    @if (!string.IsNullOrWhiteSpace(Model.Title))
    {
        <h1 class="faq-title">@Model.Title</h1>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="faq-description">@Model.Description</p>
    }

    <!-- FAQ Accordion -->
    @if (Model.Questions.Any())
    {
        <div class="faq-container">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var question = Model.Questions[i];
                var itemId = $"faq-{i}";

                <div class="faq-item">
                    <button class="faq-question-button" onclick="toggleFaq('@itemId')" type="button">
                        <span class="faq-question-text">@question.Question</span>
                        <svg id="@itemId-icon" class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div id="@itemId-answer" class="faq-answer">
                        <p>@question.Answer</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No questions available. Please create Questions content items in Kentico Admin.</p>
        </div>
    }
</div>

<script>
    function toggleFaq(id) {
        const answer = document.getElementById(id + '-answer');
        const icon = document.getElementById(id + '-icon');
        
        if (answer.classList.contains('open')) {
            answer.classList.remove('open');
            icon.classList.remove('open');
        } else {
            // Close all other open items
            document.querySelectorAll('.faq-answer.open').forEach(item => {
                item.classList.remove('open');
            });
            document.querySelectorAll('.faq-icon.open').forEach(item => {
                item.classList.remove('open');
            });
            
            // Open clicked item
            answer.classList.add('open');
            icon.classList.add('open');
        }
    }
</script>
