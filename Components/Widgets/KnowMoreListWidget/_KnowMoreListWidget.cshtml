@using Components.Widgets.KnowMoreListWidget

@model KnowMoreListWidgetViewModel

<style>
    .know-more-section {
        min-height: 100vh;
        background-color: #f3f4f6;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }

    .know-more-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .know-more-badge {
        color: #3b82f6;
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }

    .know-more-title {
        font-size: 3rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .know-more-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        max-width: 1280px;
        width: 100%;
    }

    .know-more-card {
        background-color: white;
        border-radius: 1.5rem;
        padding: 2rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        transition: box-shadow 0.3s ease;
    }

    .know-more-card:hover {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 1.5rem;
    }

    .card-icon-wrapper {
        position: relative;
        width: 5rem;
        height: 5rem;
        margin-bottom: 1.5rem;
    }

    .card-icon-blob {
        width: 100%;
        height: 100%;
    }

    .card-icon-image {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-icon-image img {
        width: 3rem;
        height: 3rem;
        object-fit: contain;
    }

    .card-description {
        color: #4b5563;
        font-size: 0.875rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-link {
        display: inline-flex;
        align-items: center;
        color: #3b82f6;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .card-link:hover {
        color: #2563eb;
        text-decoration: none;
    }

    .card-link svg {
        width: 1rem;
        height: 1rem;
        margin-left: 0.25rem;
    }

    /* Responsive */
    @@media (min-width: 768px) {
        .know-more-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 767px) {
        .know-more-title {
            font-size: 2rem;
        }
    }
</style>

<div class="know-more-section">
    <!-- Section Header -->
    <div class="know-more-header">
        @if (!string.IsNullOrWhiteSpace(Model.SectionBadge))
        {
            <p class="know-more-badge">@Model.SectionBadge</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SectionHeading))
        {
            <h1 class="know-more-title">@Model.SectionHeading</h1>
        }
    </div>

    <!-- Cards Grid -->
    @if (Model.Items.Any())
    {
        <div class="know-more-grid">
            @foreach (var item in Model.Items)
            {
                <div class="know-more-card">
                    <h2 class="card-title">@item.Title</h2>

                    <!-- Icon/Thumbnail with Blob Background -->
                    <div class="card-icon-wrapper">
                        <svg viewBox="0 0 100 100" class="card-icon-blob">
                            <path
                                d="M50 10 C20 10, 5 35, 5 55 C5 80, 25 95, 50 95 C75 95, 95 80, 95 55 C95 35, 80 10, 50 10 Z"
                                class="@item.ColorClass"
                                fill="currentColor"
                            />
                        </svg>
                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                        {
                            <div class="card-icon-image">
                                <img src="@item.ThumbnailUrl" alt="@item.Title" loading="lazy" />
                            </div>
                        }
                        else
                        {
                            <div class="card-icon-image">
                                <!-- Default icon if no thumbnail -->
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width: 2rem; height: 2rem; color: #6b7280;">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                            </div>
                        }
                    </div>

                    <p class="card-description">@item.Description</p>

                    <a href="@item.ButtonLink" class="card-link">
                        @item.ButtonName
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align: center; color: #6b7280; padding: 2rem;">
            <p>No items to display. Please create KnowMore pages in the content tree.</p>
        </div>
    }
</div>
